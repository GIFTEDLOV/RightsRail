{
  "name": "rightsrail",
  "private": true,
  "version": "0.1.0",
  "description": "RightsRail monorepo",
  "workspaces": [
    "apps/web",
    "apps/api"
  ],
  "scripts": {
    "test:python": "python -m unittest discover -s tests -t . -p test_*.py",
    "test:pytest": "pytest -q",
    "test:property": "pytest -q tests/property",
    "check:compile": "python -m compileall -q contracts packages tests",
    "lint": "ruff check .",
    "typecheck": "mypy",
    "genlayer:lint": "genvm-lint lint contracts/rightsrail.py --json",
    "genlayer:validate": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/genlayer_validate.ps1",
    "genlayer:typecheck": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/genlayer_typecheck.ps1",
    "genlayer:schema": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/genlayer_schema.ps1"
  }
}
